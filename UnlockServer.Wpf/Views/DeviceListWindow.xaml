<Window x:Class="UnlockServer.Views.DeviceListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:UnlockServer.Converters"
        mc:Ignorable="d"
        Title="搜索蓝牙设备" 
        Height="760" Width="420" 
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Closing="Window_Closing">
    
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:RssiToColorConverter x:Key="RssiToColorConverter"/>
        <converters:RssiToWidthConverter x:Key="RssiToWidthConverter"/>
    </Window.Resources>
    
    <!-- 主容器带圆角和阴影 -->
    <Border Background="{StaticResource BackgroundBrush}" 
            CornerRadius="12" 
            Margin="10"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 自定义标题栏 -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 标题 -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="🔍 搜索蓝牙设备" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="选择要绑定的设备" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <!-- 关闭按钮 -->
                    <Button Grid.Column="1" Content="✕" 
                            Style="{StaticResource IconButtonStyle}" 
                            Click="CloseButton_Click"
                            Width="30" Height="30" FontSize="12"/>
                </Grid>
            </Border>
            
            <!-- 筛选区域 -->
            <Border Grid.Row="1" Margin="16,12,16,0">
                <StackPanel>
                    <!-- 蓝牙类型选择 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="全部" 
                                     Style="{StaticResource ModernRadioButtonStyle}"
                                     IsChecked="{Binding IsAllBluetooth}"
                                     FontSize="11" Padding="8,6"
                                     Margin="0,0,6,0"/>
                        <RadioButton Content="经典" 
                                     Style="{StaticResource ModernRadioButtonStyle}"
                                     IsChecked="{Binding IsClassicBluetooth}"
                                     FontSize="11" Padding="8,6"
                                     Margin="0,0,6,0"/>
                        <RadioButton Content="BLE" 
                                     Style="{StaticResource ModernRadioButtonStyle}"
                                     IsChecked="{Binding IsBLE}"
                                     FontSize="11" Padding="8,6"/>
                        
                        <Button Content="🔄" 
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                ToolTip="刷新列表"
                                Width="34" Height="34"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ScanHint}" FontSize="10"
                               Foreground="{StaticResource TextDisabledBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    
                    <!-- 搜索框 -->
                    <Border Background="{StaticResource SurfaceBrush}" 
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Height="36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 搜索图标 -->
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="13" 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            
                            <!-- 输入框 -->
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource PrimaryBrush}"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Padding="0,0,10,0"/>
                            
                            <!-- Placeholder -->
                            <TextBlock Grid.Column="1"
                                       Text="搜索设备名称或地址..." 
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{StaticResource TextDisabledBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 ToolTip="例如 AA:BB:CC:DD:EE:FF"
                                 Tag="手动输入 MAC"/>
                        <Button Grid.Column="2" Content="手动绑定"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding UseManualAddressCommand}"
                                Padding="10,6" FontSize="11"/>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- 设备列表 -->
            <Border Grid.Row="2" Margin="16,12,16,0" 
                    Background="{StaticResource CardBrush}" 
                    CornerRadius="10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <!-- 扫描中提示（仅列表为空时显示） -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowScanningHint, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Width="50" Height="50" CornerRadius="25" 
                                Background="{StaticResource SurfaceBrush}"
                                Margin="0,0,0,10">
                            <TextBlock Text="📡" FontSize="22" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="正在扫描附近设备..." 
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="请确保蓝牙已开启" 
                                   FontSize="10"
                                   Foreground="{StaticResource TextDisabledBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <!-- 设备列表 -->
                    <ListBox ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}"
                             Style="{StaticResource ModernListBoxStyle}"
                             Margin="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- 设备图标 -->
                                    <Border Grid.Column="0" 
                                            Width="42" Height="42" 
                                            CornerRadius="21"
                                            Background="{StaticResource SurfaceBrush}"
                                            Margin="0,0,12,0">
                                        <TextBlock FontSize="18" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="📱"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="BLE">
                                                            <Setter Property="Text" Value="📡"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    
                                    <!-- 设备信息 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="180"/>
                                            <!-- 已配对标签 -->
                                            <Border Background="{StaticResource PrimaryBrush}" 
                                                    CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsPaired, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="已配对" FontSize="9" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="{StaticResource SurfaceBrush}" 
                                                    CornerRadius="3" Padding="5,2">
                                                <TextBlock Text="{Binding Type}" 
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Address}" 
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextDisabledBrush}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- 信号强度 -->
                                    <StackPanel Grid.Column="2" 
                                                VerticalAlignment="Center" 
                                                HorizontalAlignment="Right"
                                                Width="65">
                                        <TextBlock Text="{Binding RssiDisplay}" 
                                                   Foreground="{Binding Rssi, Converter={StaticResource RssiToColorConverter}}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   HorizontalAlignment="Right"/>
                                        <!-- 信号强度条 -->
                                        <Grid Height="4" Margin="0,4,0,0">
                                            <Border Background="{StaticResource SurfaceBrush}" 
                                                    CornerRadius="2"/>
                                            <Border Background="{Binding Rssi, Converter={StaticResource RssiToColorConverter}}" 
                                                    CornerRadius="2"
                                                    HorizontalAlignment="Left"
                                                    Width="{Binding Rssi, Converter={StaticResource RssiToWidthConverter}, ConverterParameter=65}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            
            <!-- 底部按钮 -->
            <Grid Grid.Row="3" Margin="16,12,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" 
                        Content="取消" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click"
                        Padding="0,10"/>
                
                <Button Grid.Column="2" 
                        Content="✓ 确定选择" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SelectCommand}"
                        Padding="0,10"/>
            </Grid>
        </Grid>
    </Border>
</Window>
