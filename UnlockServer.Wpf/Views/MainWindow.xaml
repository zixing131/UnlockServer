<Window x:Class="UnlockServer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:UnlockServer.Converters"
        Title="蓝牙解锁"
        Height="660" Width="540"
        MinHeight="660" MinWidth="540"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Closing="Window_Closing">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="{StaticResource WindowGradientBrush}" CornerRadius="16" Margin="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.42" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource TitleGradientBrush}" CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource PrimaryGradientBrush}" Margin="0,0,10,0">
                        <TextBlock Text="U" FontSize="16" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="蓝牙解锁" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="靠近解锁  ·  离开锁屏" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextDisabledBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Button Content="─" Style="{StaticResource IconButtonStyle}" Click="MinimizeButton_Click" Width="30" Height="30"/>
                        <Button Content="✕" Style="{StaticResource IconButtonStyle}" Click="CloseButton_Click" Width="30" Height="30"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="16,12,16,0" Background="{StaticResource CardGradientBrush}"
                    CornerRadius="14" Padding="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="14,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeviceInRange}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,10,8,10">
                        <TextBlock Text="当前状态" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding CurrentRssi}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeviceInRange}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SetupHint}" FontSize="11" Foreground="{StaticResource WarningBrush}"
                                   TextWrapping="Wrap" Margin="0,4,12,0"
                                   Visibility="{Binding HasSetupHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button Command="{Binding ToggleMonitoringCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,8" Margin="0,0,8,0">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="开始监控"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                <Setter Property="Text" Value="停止监控"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Content="锁屏" Command="{Binding LockScreenCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="16,10,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="4" Margin="0,0,0,10">
                    <UniformGrid Columns="3">
                        <Button Content="设备" Command="{Binding SelectTabCommand}" CommandParameter="0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabChipStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTabDevices}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="解锁" Command="{Binding SelectTabCommand}" CommandParameter="1">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabChipStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTabUnlock}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="规则" Command="{Binding SelectTabCommand}" CommandParameter="2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabChipStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTabRules}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>
                </Border>

                <Grid Grid.Row="1" Visibility="{Binding IsTabDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource SurfaceBrush}" Margin="0,0,0,12">
                                    <TextBlock Text="+" FontSize="24" Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="还没有绑定设备" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" FontWeight="Medium"/>
                                <TextBlock Text="添加后，靠近自动解锁，离开自动锁屏" FontSize="11" Foreground="{StaticResource TextDisabledBrush}" Margin="0,6,0,14" HorizontalAlignment="Center"/>
                                <Button Content="添加设备" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SearchDeviceCommand}" Padding="20,10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding BoundDevices}" Style="{StaticResource ModernListBoxStyle}" Margin="6"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInRange}" Value="True">
                                                                <Setter Property="Background" Value="#1A34D399"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Ellipse Width="8" Height="8">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource TextDisabledBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInRange}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Medium" FontSize="13"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="{StaticResource TextDisabledBrush}"/>
                                                    <TextBlock Text="  ·  " FontSize="10" Foreground="{StaticResource TextDisabledBrush}"/>
                                                    <TextBlock Text="{Binding Address}" FontSize="10" Foreground="{StaticResource TextDisabledBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInRange}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <CheckBox Content="启用" IsChecked="{Binding Enabled}" Style="{StaticResource ToggleSwitchStyle}" FontSize="11" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="移除" Style="{StaticResource GhostButtonStyle}"
                                                    Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="需要全部设备都在附近" Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding Settings.RequireAllDevices}" FontSize="12"
                                  Visibility="{Binding HasMultipleDevices, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Grid.Column="2" Content="添加设备" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SearchDeviceCommand}" Padding="14,8"/>
                    </Grid>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12"
                        Visibility="{Binding IsTabUnlock, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="本机解锁" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Row="1" Text="填写 Windows 登录密码（不是 PIN），启用后锁屏可直接解开。"
                                   FontSize="11" Foreground="{StaticResource TextDisabledBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="用户名" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding Settings.Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Windows 密码" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBoxStyle}" PasswordChanged="PasswordBox_PasswordChanged"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="3" Text="{Binding LocalUnlockStatus}" FontSize="11" Margin="0,0,0,8"
                                   MinHeight="18" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLocalUnlockReady}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <CheckBox Grid.Row="4" Content="优先使用本机解锁" Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding Settings.UseLocalUnlock}" FontSize="12" Margin="0,0,0,8"/>
                        <Grid Grid.Row="5" Height="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="{Binding InstallButtonText}" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding InstallLocalUnlockCommand}" Padding="0" Height="36"/>
                            <Button Grid.Column="2" Content="卸载" Style="{StaticResource SecondaryButtonStyle}"
                                    Foreground="{StaticResource ErrorBrush}" BorderBrush="{StaticResource ErrorBrush}"
                                    Command="{Binding UninstallLocalUnlockCommand}"
                                    IsEnabled="{Binding CanUninstallLocalUnlock}" Padding="0" Height="36"/>
                            <Button Grid.Column="4" Content="测试解锁" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding TestUnlockCommand}"
                                    IsEnabled="{Binding CanTestUnlock}" Padding="0" Height="36"/>
                        </Grid>
                        <TextBlock Grid.Row="7" Text="备用远程服务" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,4"/>
                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.ServerIp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            <TextBox Grid.Column="2" Text="{Binding Settings.ServerPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </Grid>
                        <Button Grid.Row="9" Content="测试远程服务" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding TestServerCommand}" Padding="10,7" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12"
                        Visibility="{Binding IsTabRules, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="开关" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDisabledBrush}" Margin="2,0,0,8"/>
                        <UniformGrid Grid.Row="1" Columns="2" Rows="3">
                            <CheckBox Content="离开后自动锁屏" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.AutoLock}" FontSize="12" Margin="0,0,12,8"/>
                            <CheckBox Content="靠近后自动解锁" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.AutoUnlock}" FontSize="12" Margin="0,0,0,8"/>
                            <CheckBox Content="开机后自动运行" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.AutoStart}" FontSize="12" Margin="0,0,12,8"/>
                            <CheckBox Content="不干预手动锁定" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.ManualLock}" FontSize="12" Margin="0,0,0,8"/>
                            <CheckBox Content="不干预手动解锁" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.ManualUnlock}" FontSize="12" Margin="0,0,12,0"/>
                            <CheckBox Content="空闲时才锁定" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.LockOnlyWhenIdle}" FontSize="12"/>
                        </UniformGrid>

                        <TextBlock Grid.Row="3" Text="时间与信号" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDisabledBrush}" Margin="2,0,0,8"/>
                        <UniformGrid Grid.Row="4" Columns="2">
                            <Border Style="{StaticResource SettingFieldStyle}" Margin="0,0,6,0">
                                <Grid>
                                    <TextBlock Text="离开后锁屏" Style="{StaticResource SettingLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding Settings.LockDelay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingValueBoxStyle}"/>
                                        <TextBlock Text="秒" Style="{StaticResource SettingUnitStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingFieldStyle}" Margin="6,0,0,0">
                                <Grid>
                                    <TextBlock Text="空闲多久" Style="{StaticResource SettingLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding Settings.IdleLockSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingValueBoxStyle}"/>
                                        <TextBlock Text="秒" Style="{StaticResource SettingUnitStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>
                        <UniformGrid Grid.Row="6" Columns="2">
                            <Border Style="{StaticResource SettingFieldStyle}" Margin="0,0,6,0">
                                <Grid>
                                    <TextBlock Text="靠近后解锁" Style="{StaticResource SettingLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding Settings.UnlockDelay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingValueBoxStyle}"/>
                                        <TextBlock Text="秒" Style="{StaticResource SettingUnitStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingFieldStyle}" Margin="6,0,0,0">
                                <Grid>
                                    <TextBlock Text="操作前提示" Style="{StaticResource SettingLabelStyle}"
                                               ToolTip="锁屏前右下角提示；解锁前在锁屏磁贴上提示"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding Settings.ActionWarnSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingValueBoxStyle}"/>
                                        <TextBlock Text="秒" Style="{StaticResource SettingUnitStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>
                        <UniformGrid Grid.Row="8" Columns="2">
                            <Border Style="{StaticResource SettingFieldStyle}" Margin="0,0,6,0">
                                <Grid>
                                    <TextBlock Text="信号阈值" Style="{StaticResource SettingLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding Settings.RssiThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingValueBoxStyle}" Width="48"/>
                                        <TextBlock Text="dBm" Style="{StaticResource SettingUnitStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingFieldStyle}" Margin="6,0,0,0">
                                <Grid>
                                    <TextBlock Text="滞后 / 丢失" Style="{StaticResource SettingLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding Settings.HysteresisDb, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingValueBoxStyle}" Width="36"/>
                                        <TextBlock Text="dB" Style="{StaticResource SettingUnitStyle}" Margin="4,0,8,0"/>
                                        <TextBox Text="{Binding Settings.PresenceTimeout, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingValueBoxStyle}" Width="36"/>
                                        <TextBlock Text="秒" Style="{StaticResource SettingUnitStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
