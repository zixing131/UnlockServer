<Window x:Class="UnlockServer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UnlockServer.Views"
        xmlns:vm="clr-namespace:UnlockServer.ViewModels"
        xmlns:converters="clr-namespace:UnlockServer.Converters"
        mc:Ignorable="d"
        Title="蓝牙解锁工具" 
        Height="810" Width="420"
        MinHeight="600" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Closing="Window_Closing">
    
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:RssiToColorConverter x:Key="RssiToColorConverter"/>
    </Window.Resources>
    
    <!-- 主容器带圆角和阴影 -->
    <Border Background="{StaticResource BackgroundBrush}" 
            CornerRadius="12" 
            Margin="10"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- 自定义标题栏 -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                    CornerRadius="12,12,0,0" 
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Logo和标题 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="32" Height="32">
                            <Ellipse Fill="{StaticResource PrimaryGradientBrush}">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{StaticResource PrimaryColor}" BlurRadius="8" Opacity="0.3" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="🔓" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="蓝牙解锁工具" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="v2.0" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- 状态指示 -->
                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="8,3" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,5,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextDisabledBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 窗口控制按钮 -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="─" Style="{StaticResource IconButtonStyle}" 
                                Click="MinimizeButton_Click" 
                                Width="30" Height="30" FontSize="12"/>
                        <Button Content="✕" Style="{StaticResource IconButtonStyle}" 
                                Click="CloseButton_Click"
                                Width="30" Height="30" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- 主内容区域 -->
            <StackPanel Grid.Row="1" Margin="16,10,16,16">
                
                <!-- 设备状态卡片 -->
                <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="当前设备" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DeviceDisplayName}" 
                                           Foreground="{StaticResource TextPrimaryBrush}" 
                                           FontSize="14" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="信号: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CurrentRssi}" FontSize="12" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeviceInRange}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            
                            <Button Grid.Column="1" 
                                    Content="🔍 搜索" 
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SearchDeviceCommand}"
                                    Padding="12,6" FontSize="12"/>
                        </Grid>
                        
                        <!-- 蓝牙类型显示（只读） -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="类型：" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" 
                                       VerticalAlignment="Center"/>
                            <Border Background="{StaticResource SurfaceBrush}" 
                                    CornerRadius="4" Padding="8,4" Margin="4,0,0,0">
                                <TextBlock FontSize="11" Foreground="{StaticResource TextPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="📶 经典蓝牙"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBLE}" Value="True">
                                                    <Setter Property="Text" Value="📡 BLE低功耗"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- 快捷操作 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" 
                            Command="{Binding ToggleMonitoringCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="▶"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                <Setter Property="Text" Value="⏹"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="开始监控"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                <Setter Property="Text" Value="停止监控"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    
                    <Button Grid.Column="2" 
                            Content="🔒 锁屏"
                            Command="{Binding LockScreenCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="0,10"/>
                </Grid>
                
                <!-- 服务器设置卡片 -->
                <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="服务器设置" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        
                        <!-- 第一行：IP地址 和 端口 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="IP 地址" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Settings.ServerIp, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="端口" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Settings.ServerPort, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- 第二行：用户名 和 密码 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="用户名" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Settings.Username, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="密码" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="PasswordBox"
                                             Style="{StaticResource ModernPasswordBoxStyle}"
                                             PasswordChanged="PasswordBox_PasswordChanged"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- 自动化设置卡片 -->
                <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="信号阈值" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="低于此值触发锁屏" FontSize="10" Foreground="{StaticResource TextDisabledBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Text="{Binding Settings.RssiThreshold, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Width="50" TextAlignment="Center" Padding="6,4"/>
                                <TextBlock Text="dBm" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" 
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- 延迟设置 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="延迟设置" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="离开/进入后触发的等待时间" FontSize="10" Foreground="{StaticResource TextDisabledBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="锁定" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding Settings.LockDelay, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}" TextAlignment="Center"
                                         Width="45" FontSize="13" Padding="4,4"/>
                                <TextBlock Text="秒" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                                           VerticalAlignment="Center" Margin="4,0,12,0"/>
                                <TextBlock Text="解锁" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding Settings.UnlockDelay, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}" TextAlignment="Center"
                                         Width="45" FontSize="13" Padding="4,4"/>
                                <TextBlock Text="秒" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- 开关选项 - 两列布局 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <CheckBox Grid.Row="0" Grid.Column="0" Content="自动锁定" 
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding Settings.AutoLock}"
                                      FontSize="12"/>
                            <CheckBox Grid.Row="0" Grid.Column="1" Content="自动解锁" 
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding Settings.AutoUnlock}"
                                      FontSize="12"/>
                            
                            <CheckBox Grid.Row="2" Grid.Column="0" Content="不干预手动锁定" 
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding Settings.ManualLock}"
                                      FontSize="12"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" Content="不干预手动解锁" 
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding Settings.ManualUnlock}"
                                      FontSize="12"/>
                            
                            <CheckBox Grid.Row="4" Grid.Column="0" Content="开机自启" 
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding Settings.AutoStart}"
                                      FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- 保存按钮 -->
                <Button Content="💾 保存设置" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveSettingsCommand}"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        Margin="0,0,0,10"/>
                
                <!-- 关于链接 -->
                <TextBlock HorizontalAlignment="Center" FontSize="11">
                    <Hyperlink Click="Hyperlink_Click" Foreground="{StaticResource PrimaryBrush}">
                        查看使用说明
                    </Hyperlink>
                </TextBlock>
                
            </StackPanel>
        </Grid>
    </Border>
</Window>
